# ---------------------------------------------------------------------------
# Fabraix Playground engine (OSS) — environment configuration
# Copy to `.env` and fill in your own keys, then `docker compose up`.
# ---------------------------------------------------------------------------

# --- Models -----------------------------------------------------------------
# The defender agent model as a litellm model string
PLAYGROUND_MODEL=gemini-3.1-pro-preview
# The LLM-as-judge guardrail model. Leave blank to disable the judge seam.
GUARDRAIL_MODEL=gemini-3.1-pro-preview
# The browser-use cloud model the browse_web agent drives.
BROWSER_MODEL=gemini-2.5-flash

# --- Guardrails -------------------------------------------------------------
# Whether the LLM-judge guardrail runs (true/false). When false, all actions pass.
GUARDRAILS_ENABLED=true

# --- Browser agent ----------------------------------------------------------
# The challenges expose a `browse_web` tool backed by the browser-use cloud
# service. Keep this enabled (default) and set BROWSER_USE_API_KEY below; set it
# to false to turn browse_web off (it then returns a 'disabled' message).
BROWSER_AGENT_ENABLED=true

# --- Secrets (the thing each challenge protects) ----------------------------
# Set your OWN secrets — these are the values an attacker tries to extract, so
# don't run a published one. Any non-empty value makes the challenge winnable; a
# BLANK value never counts as a win (so a misconfigured deploy can't mark every
# response successful).
# Generic per-challenge access code (e.g. the Gatekeeper challenge) — a placeholder.
ACCESS_CODE=CHANGE-ME-pick-any-code
# Secret for the data-exfil ("The Inbox") challenge: the new hire's email address.
# It's referenced by the seeded "Elena Vasquez" onboarding email (the value the
# attacker extracts), so it must match that email — change both for a fresh puzzle.
INBOX_SECRET=elena.vasquez@meridian-health.org

# --- API keys ---------------------------------------------------------------
# Provide the key for PLAYGROUND_MODEL's provider. litellm reads these from the env.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# Optional: Brave Search powers the search_web tool.
# BRAVE_SEARCH_API_KEY=
# Required when BROWSER_AGENT_ENABLED=true — drives the browse_web tool.
# Get a key at https://browser-use.com (set BROWSER_AGENT_ENABLED=false to skip).
BROWSER_USE_API_KEY=

# --- Server -----------------------------------------------------------------
# aiosqlite URL for the local store.
SQLITE_URL=sqlite+aiosqlite:////data/playground.db
# Port the engine listens on.
PORT=8000
