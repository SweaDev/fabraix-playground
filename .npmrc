# Supply-chain hardening: quarantine freshly-published packages.
#
# The units DIFFER per tool — do not copy one value into the other key:
#   - npm 11.10.0+  reads `min-release-age` in DAYS.
#   - pnpm 10.16+   reads `minimum-release-age` in MINUTES.
#   - Yarn 4.10+    reads `npmMinimalAgeGate` from .yarnrc.yml separately.
# Both values below express the same 7-day quarantine.
#
# npm applies this during version resolution, so `npm install` enforces it and
# `npm ci` does not — `npm ci` installs the lockfile verbatim. The Dockerfiles
# that run `npm install` are what this setting actually gates.
#
# Bump to `0` only with a documented exception.
min-release-age=7
minimum-release-age=10080
